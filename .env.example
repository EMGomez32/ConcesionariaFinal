# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno para docker compose (producción).
# Copiá este archivo a ".env" en el servidor y completá los valores.
# El .env NO debe compartirse ni subirse a repositorios públicos.
#
# Generar secretos fuertes:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ─────────────────────────────────────────────────────────────────────────────

# --- Base de datos (conexión ADMIN / superusuario) ---
# La usan SOLO las tareas de setup del arranque (prisma migrate deploy, init-rls,
# setup-app-role). El runtime de la app NO la usa si se activa app_rw (abajo).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_por_password_fuerte
POSTGRES_DB=concesionaria

# --- Rol de RUNTIME de la app (OPCIONAL pero MUY recomendado) ---
# Hace que la Row Level Security de Postgres FILTRE de verdad: un superusuario la
# saltea siempre, así que si la app corre con `postgres` la RLS es decorativa (hoy
# el aislamiento lo da sólo la extensión de Prisma). Con app_rw (NO superusuario),
# la RLS es una segunda capa real que atrapa cualquier query que se escape de la
# extensión (p.ej. un camino raw).
#
# Cutover (una vez): elegí una password fuerte, seteá LAS DOS variables con esa
# MISMA password y redeployá. setup-app-role crea/actualiza el rol app_rw en el
# arranque y la app pasa a conectar como app_rw.
#   Generar password:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# OBLIGATORIAS en producción: sin APP_DATABASE_URL el backend NO arranca (antes caía en
# silencio al superusuario y la RLS quedaba decorativa). Además el proceso del servidor
# arranca con la conexión de app_rw, sin las credenciales de superusuario en su entorno.
# Rollback de EMERGENCIA (RLS inactiva, no dejarlo): ALLOW_SUPERUSER_DB=1 y vaciar APP_DATABASE_URL.
# ALLOW_SUPERUSER_DB=
# APP_DB_PASSWORD=CAMBIAR_por_password_fuerte_de_app_rw
# APP_DATABASE_URL=postgresql://app_rw:CAMBIAR_por_password_fuerte_de_app_rw@db:5432/concesionaria?sslmode=disable

# --- Secretos JWT (deben ser distintos entre sí y largos) ---
JWT_SECRET=CAMBIAR_por_secreto_aleatorio_largo
JWT_REFRESH_SECRET=CAMBIAR_por_OTRO_secreto_aleatorio_largo

# --- Duración máxima de la sesión (OPCIONAL) ---
# Días desde el login después de los cuales hay que volver a entrar con la contraseña,
# aunque la sesión se haya ido renovando todos los días (cada renovación la estira 7
# días; esto es el tope). Entre 1 y 365. Vacía o sin definir = 30.
# SESION_MAX_DIAS=30

# --- Cifrado de secretos en la base (OBLIGATORIA en producción) ---
# Clave AES-256 ACTUAL con la que se cifran los secretos de las integraciones (appSecret
# y tokens de Meta, contraseña IMAP, tokens de Mercado Libre) y los secretos del 2FA.
# Sin ella el backend NO arranca en producción.
#   Generarla EN el servidor:  openssl rand -hex 32   (64 caracteres hex)
#   Guardá una copia en el gestor de contraseñas: sin la MISMA clave no se pueden leer
#   los secretos ya cifrados (ni restaurar un backup con ellos).
#   Si ya existe en el .env, NO la reemplaces a mano: para cambiarla usá la rotación de
#   abajo. Si es la primera vez, los secretos que estaban en claro se siguen leyendo y
#   se cifran al volver a guardarse (o todos juntos con `npm run recifrar-secretos`).
INTEGRACIONES_SECRET_KEY=
# Rotación (OPCIONAL; vacía = sin rotación en curso, lo normal): claves VIEJAS, de 64 hex
# y separadas por comas, que sólo sirven para LEER lo que se cifró con ellas. Nunca se
# cifra con estas. Procedimiento (detalle en docs/seguridad/criptografia-y-secretos.md):
#   1. openssl rand -hex 32 → la clave nueva al gestor de contraseñas.
#   2. La clave actual pasa acá; la nueva va en INTEGRACIONES_SECRET_KEY.
#   3. docker compose up -d backend   (el log de arranque muestra el kid actual y los anteriores)
#   4. docker compose exec -T backend npm run recifrar-secretos </dev/null            (simulación)
#      docker compose exec -T backend npm run recifrar-secretos -- --apply </dev/null
#   5. Con «verificado: todo está en v2 con la clave …», vaciar esta variable y volver a
#      hacer docker compose up -d backend. La clave vieja NO se borra del gestor mientras
#      haya backups de antes de la rotación (vienen cifrados con ella).
INTEGRACIONES_SECRET_KEYS_ANTERIORES=

# --- Alertas de seguridad (OPCIONAL, muy recomendado) ---
# POST JSON a esta URL (https) por cada evento que hay que mirar ya: racha de logins
# fallidos, reuso de un refresh token (posible sesión robada) y login de un super_admin.
# Sin datos personales más allá de ids y emails enmascarados. Vacía = sin alertas (los
# eventos quedan igual en security_events y en el log).
# SECURITY_ALERT_WEBHOOK_URL=https://ntfy.sh/TU-TOPIC-SECRETO

# --- CORS / logging ---
# SOLO el dominio público. Vacía o sin definir, docker compose usa APP_URL. Nunca
# localhost acá: cualquier página servida en el localhost de quien visita podría
# llamar a la API con su sesión. Para desarrollo está BackConcesionaria/.env.
CORS_ALLOWED_ORIGINS=https://autenza.nebulant.com.ar
LOG_LEVEL=info

# --- URL pública del frontend (para el link de recuperación de contraseña) ---
APP_URL=https://autenza.nebulant.com.ar

# --- SMTP para envío de emails (OPCIONAL) ---
# Si no lo configurás, la recuperación de contraseña sigue funcionando: el link
# se escribe en los logs del backend (docker compose logs backend) en vez de
# enviarse por email. Completá esto cuando tengas un proveedor (Gmail, SES, Resend...).
# SMTP_HOST=smtp.tuproveedor.com
# SMTP_PORT=587
# SMTP_USER=usuario
# SMTP_PASS=contraseña
# SMTP_FROM=no-reply@autenza.com.ar

# --- WhatsApp (Baileys) — espaciado anti-ban (OPCIONAL) ---
# Gap aleatorio entre envíos consecutivos del MISMO número: cada mensaje que
# sale de la bandeja se agenda entre MIN y MAX ms después del anterior, y el
# worker no lo despacha antes de esa hora. Baileys NO es la API oficial de
# Meta: mandar en ráfaga es la forma más rápida de que baneen el número.
# Si no las setés, docker-compose usa estos mismos valores por default.
# WHATSAPP_DELAY_MIN_MS=5000
# WHATSAPP_DELAY_MAX_MS=15000
#
# La tercera variable, WHATSAPP_AUTH_DIR, NO va acá: está fija en
# docker-compose.yml (/app/wa-auth) porque tiene que coincidir con el punto de
# montaje del volumen `wa-auth`, donde viven las credenciales de los números
# vinculados. Si borrás ese volumen, hay que re-escanear el QR de cada número.

# --- Mercado Libre (OPCIONAL: sin estas, la integración real queda apagada) ---
# Credenciales de la aplicación creada en developers.mercadolibre.com.ar. Van las dos
# juntas o ninguna: con una sola el backend no arranca. Los tokens de cada
# concesionaria se guardan cifrados con INTEGRACIONES_SECRET_KEY.
# ML_CLIENT_ID=
# ML_CLIENT_SECRET=
# Vacía = <APP_URL>/api/webhooks/mercadolibre/callback. Si la definís, tiene que
# coincidir EXACTO con la registrada en la aplicación de Mercado Libre.
# ML_REDIRECT_URI=
# ML_SITE_ID=MLA
# ML_SYNC_INTERVAL_MS=300000

# --- Retención de backups (días) ---
BACKUP_RETENTION_DAYS=14

# --- CIFRADO de backups con age (MUY recomendado; obligatorio para el offsite) ---
# El backup incluye DNI, ingresos, hashes de contraseña, las credenciales de
# WhatsApp (wa-auth) y los secretos de integraciones. Con esta clave PÚBLICA los
# archivos salen cifrados; la clave PRIVADA se guarda FUERA de la Pi (gestor de
# contraseñas) y sólo se usa para restaurar. Sin esto NO se sube nada al offsite.
#   1. En tu PC:  age-keygen -o age-identity.txt   (imprime la clave pública "age1...")
#   2. Pegá la pública acá. Podés poner varias separadas por espacio.
#   3. Guardá age-identity.txt en el gestor de contraseñas. NUNCA en la Pi ni en git.
# BACKUP_AGE_RECIPIENT=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Comando de alerta ante un fallo de backup (recibe tipo y motivo como $1 y $2).
# Ej. (ntfy.sh):  BACKUP_ALERT_CMD='wget -q -O- --post-data "$2" https://ntfy.sh/TU-TOPIC-SECRETO'
# BACKUP_ALERT_CMD=
# BACKUP_OFFSITE_ALLOW_PLAINTEXT=0   # NO recomendado: 1 sube backups SIN cifrar

# --- Backup OFFSITE a Cloudflare R2 (OPCIONAL, muy recomendado) ---
# Sin esto, los dumps viven SOLO en la Pi: si muere el disco, se pierden todos.
# Pasos (una vez):
#   1. Panel de Cloudflare → R2 → crear un bucket (ej: autenza-backups).
#   2. R2 → Manage R2 API Tokens → crear token "Object Read & Write";
#      anotá Access Key ID, Secret Access Key y tu Account ID.
#   3. Descomentá y completá las vars de abajo. BACKUP_OFFSITE_REMOTE es el
#      master switch: si está vacío/comentado, el offsite se desactiva y el
#      backup local sigue funcionando igual.
# BACKUP_OFFSITE_REMOTE=r2:autenza-backups/db
# RCLONE_CONFIG_R2_TYPE=s3
# RCLONE_CONFIG_R2_PROVIDER=Cloudflare
# RCLONE_CONFIG_R2_ACCESS_KEY_ID=
# RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_R2_ENDPOINT=https://TU_ACCOUNT_ID.r2.cloudflarestorage.com

# ─────────────────────────────────────────────────────────────────────────────
# Bootstrap del admin inicial (SOLO se usa al correr el seed manualmente
# la primera vez; ver README). Si no vas a correr el seed, podés dejarlas vacías.
# ─────────────────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@tuconcesionaria.com
SEED_ADMIN_PASSWORD=CAMBIAR_por_password_fuerte_min_10
SEED_ADMIN_NOMBRE=Administrador
SEED_CONCESIONARIA_NOMBRE=Mi Concesionaria
SEED_CONCESIONARIA_CUIT=
SEED_CONCESIONARIA_EMAIL=
SEED_SUCURSAL_NOMBRE=Casa Central

# --- 2FA (verificación en dos pasos, TOTP) ---
# Roles que DEBEN activarlo (separados por coma). Quien tiene ese rol y no lo activó puede entrar, pero la
# API sólo le deja configurarlo hasta que lo haga. Vacío/sin definir: super_admin Y admin EN PRODUCCIÓN
# (nadie en desarrollo). Avisá a los administradores antes del deploy que lo activa: en su próximo login
# se les pide escanear el QR.
# Para exigírselo sólo al super_admin (vuelta atrás si los admins todavía no pueden): MFA_REQUIRED_ROLES=super_admin
# ESCAPE DE EMERGENCIA (si alguien quedó afuera): MFA_REQUIRED_ROLES=none y `docker compose up -d backend`; o
# apagar el 2FA de UNA cuenta: docker compose exec -T backend node dist-ops/scripts/reset-2fa.js persona@dominio.com </dev/null
# El secreto de cada usuario se guarda cifrado con INTEGRACIONES_SECRET_KEY (ver arriba).
# MFA_REQUIRED_ROLES=

# --- Costo de bcrypt para las contraseñas (OPCIONAL) ---
# Vacío = 12 (en la Pi: ~460 ms por login). Cada punto duplica el tiempo del login Y lo que
# cuesta crackear un volcado de la base. Rango 10 a 14. Los hashes viejos se actualizan
# solos en el próximo login de cada usuario.
# BCRYPT_COST=12

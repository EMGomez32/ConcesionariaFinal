# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno para docker compose (producción).
# Copiá este archivo a ".env" en el servidor y completá los valores.
# El .env NO debe compartirse ni subirse a repositorios públicos.
#
# Generar secretos fuertes:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ─────────────────────────────────────────────────────────────────────────────

# --- Base de datos (conexión ADMIN / superusuario) ---
# La usan SOLO las tareas de setup del arranque (prisma db push, init-rls,
# setup-app-role). El runtime de la app NO la usa si se activa app_rw (abajo).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_por_password_fuerte
POSTGRES_DB=concesionaria

# --- Rol de RUNTIME de la app (OPCIONAL pero MUY recomendado) ---
# Hace que la Row Level Security de Postgres FILTRE de verdad: un superusuario la
# saltea siempre, así que si la app corre con `postgres` la RLS es decorativa (hoy
# el aislamiento lo da sólo la extensión de Prisma). Con app_rw (NO superusuario),
# la RLS es una segunda capa real que atrapa cualquier query que se escape de la
# extensión (p.ej. un camino raw).
#
# Cutover (una vez): elegí una password fuerte, seteá LAS DOS variables con esa
# MISMA password y redeployá. setup-app-role crea/actualiza el rol app_rw en el
# arranque y la app pasa a conectar como app_rw.
#   Generar password:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Rollback: comentá/vaciá APP_DATABASE_URL (la app vuelve al superusuario).
# APP_DB_PASSWORD=CAMBIAR_por_password_fuerte_de_app_rw
# APP_DATABASE_URL=postgresql://app_rw:CAMBIAR_por_password_fuerte_de_app_rw@db:5432/concesionaria?sslmode=disable

# --- Secretos JWT (deben ser distintos entre sí y largos) ---
JWT_SECRET=CAMBIAR_por_secreto_aleatorio_largo
JWT_REFRESH_SECRET=CAMBIAR_por_OTRO_secreto_aleatorio_largo

# --- CORS / logging ---
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,https://autenza.nebulant.com.ar
LOG_LEVEL=info

# --- URL pública del frontend (para el link de recuperación de contraseña) ---
APP_URL=https://autenza.nebulant.com.ar

# --- SMTP para envío de emails (OPCIONAL) ---
# Si no lo configurás, la recuperación de contraseña sigue funcionando: el link
# se escribe en los logs del backend (docker compose logs backend) en vez de
# enviarse por email. Completá esto cuando tengas un proveedor (Gmail, SES, Resend...).
# SMTP_HOST=smtp.tuproveedor.com
# SMTP_PORT=587
# SMTP_USER=usuario
# SMTP_PASS=contraseña
# SMTP_FROM=no-reply@autenza.com.ar

# --- Retención de backups (días) ---
BACKUP_RETENTION_DAYS=14

# --- Backup OFFSITE a Cloudflare R2 (OPCIONAL, muy recomendado) ---
# Sin esto, los dumps viven SOLO en la Pi: si muere el disco, se pierden todos.
# Pasos (una vez):
#   1. Panel de Cloudflare → R2 → crear un bucket (ej: autenza-backups).
#   2. R2 → Manage R2 API Tokens → crear token "Object Read & Write";
#      anotá Access Key ID, Secret Access Key y tu Account ID.
#   3. Descomentá y completá las vars de abajo. BACKUP_OFFSITE_REMOTE es el
#      master switch: si está vacío/comentado, el offsite se desactiva y el
#      backup local sigue funcionando igual.
# BACKUP_OFFSITE_REMOTE=r2:autenza-backups/db
# RCLONE_CONFIG_R2_TYPE=s3
# RCLONE_CONFIG_R2_PROVIDER=Cloudflare
# RCLONE_CONFIG_R2_ACCESS_KEY_ID=
# RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_R2_ENDPOINT=https://TU_ACCOUNT_ID.r2.cloudflarestorage.com

# ─────────────────────────────────────────────────────────────────────────────
# Bootstrap del admin inicial (SOLO se usa al correr el seed manualmente
# la primera vez; ver README). Si no vas a correr el seed, podés dejarlas vacías.
# ─────────────────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@tuconcesionaria.com
SEED_ADMIN_PASSWORD=CAMBIAR_por_password_fuerte_min_10
SEED_ADMIN_NOMBRE=Administrador
SEED_CONCESIONARIA_NOMBRE=Mi Concesionaria
SEED_CONCESIONARIA_CUIT=
SEED_CONCESIONARIA_EMAIL=
SEED_SUCURSAL_NOMBRE=Casa Central

  vehiculo        Vehiculo  @relation(fields: [vehiculoCanjeId], references: [id])
  venta           Venta     @relation(fields: [ventaId], references: [id])

  @@index([concesionariaId])
  @@index([ventaId])
  @@index([vehiculoCanjeId])
  @@map("venta_canje_vehiculo")
}

model Financiacion {
  id              Int                @id @default(autoincrement())
  concesionariaId Int                @map("concesionaria_id")
  sucursalId      Int?               @map("sucursal_id")
  // Sin @unique: refinanciar genera una nueva financiación sobre la misma venta.
  // Además, con @unique un contrato soft-borrado seguía ocupando el lugar y esa
  // venta no se podía volver a financiar nunca.
  ventaId         Int                @map("venta_id")
  clienteId       Int                @map("cliente_id")
  cobradorId      Int?               @map("cobrador_id")
  fechaInicio     DateTime           @map("fecha_inicio") @db.Date
  montoFinanciado Decimal            @map("monto_financiado") @db.Decimal(12, 2)
  moneda          String             @default("ARS")
  cuotas          Int
  diaVencimiento  Int                @map("dia_vencimiento")
  tasaMensual     Decimal?           @map("tasa_mensual") @db.Decimal(8, 4)
  estado          EstadoFinanciacion @default(activa)
  observaciones   String?
  // Contrato al que esta financiación refinancia. Null si es la original.
  // Sin @unique a propósito: agregar un índice único sobre una tabla con datos
  // hace abortar al `prisma db push` del arranque (que corre sin
  // --accept-data-loss), y el contenedor no levantaría. Que un contrato tenga
  // una sola refinanciación lo garantiza RefinanciarFinanciacion.
  refinanciaAId   Int?               @map("refinancia_a_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  deletedAt       DateTime?          @map("deleted_at")
  cuotasPlan      Cuota[]
  // El contrato viejo que quedó saldado por esta refinanciación...
  refinanciaA     Financiacion?      @relation("Refinanciacion", fields: [refinanciaAId], references: [id])
  // ...y, del otro lado, la refinanciación que cerró a este contrato. Es una
  // lista por la limitación de arriba, pero el use-case garantiza a lo sumo una.
  refinanciadaPor Financiacion[]     @relation("Refinanciacion")
  cliente         Cliente            @relation(fields: [clienteId], references: [id])
  cobrador        Usuario?           @relation("FinanciacionCobrador", fields: [cobradorId], references: [id])
  concesionaria   Concesionaria      @relation(fields: [concesionariaId], references: [id])
  sucursal        Sucursal?          @relation(fields: [sucursalId], references: [id])
  venta           Venta              @relation(fields: [ventaId], references: [id])

  @@index([concesionariaId])
  @@index([sucursalId])
  @@index([clienteId])
  @@index([cobradorId])
  @@map("financiaciones")
}

model Cuota {
  id                Int          @id @default(autoincrement())
  concesionariaId   Int?          @map("concesionaria_id")
  financiacionId    Int          @map("financiacion_id")
  nroCuota          Int          @map("nro_cuota")
  vencimiento       DateTime     @db.Date
  montoCuota        Decimal      @map("monto_cuota") @db.Decimal(12, 2)
  saldoCuota        Decimal      @map("saldo_cuota") @db.Decimal(12, 2)
  estado            EstadoCuota  @default(pendiente)
  fechaPagoCompleto DateTime?    @map("fecha_pago_completo") @db.Date
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  deletedAt         DateTime?    @map("deleted_at")
  financiacion      Financiacion @relation(fields: [financiacionId], references: [id])
  pagos             PagoCuota[]

  @@unique([financiacionId, nroCuota])
  @@index([concesionariaId])
  @@index([vencimiento])
  @@index([estado])
  @@map("cuotas")
}

model PagoCuota {
  id              Int        @id @default(autoincrement())
  concesionariaId Int?        @map("concesionaria_id")
  cuotaId         Int        @map("cuota_id")
  fechaPago       DateTime   @map("fecha_pago")
  monto           Decimal    @db.Decimal(12, 2)
  metodo          MetodoPago
  referencia      String?
  observaciones   String?
  // Clave de idempotencia por request (la genera el front al abrir el modal de
  // cobro). Unique global: un reenvío del mismo cobro (doble-submit / retry de
  // red) no crea un segundo PagoCuota. Nullable: los pagos sin clave (histórico,
  // request sin key) no chocan entre sí (Postgres trata cada NULL como distinto).
  idempotencyKey  String?    @unique @map("idempotency_key")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")
  cuota           Cuota      @relation(fields: [cuotaId], references: [id])

  @@index([concesionariaId])
  @@index([cuotaId])
  @@index([fechaPago])
  @@map("pagos_cuota")
}

model Financiera {
  id              Int                     @id @default(autoincrement())
  concesionariaId Int                     @map("concesionaria_id")
  nombre          String
  tipo            TipoFinanciera          @default(financiera)
  contacto        String?
  telefono        String?
  email           String?
  activo          Boolean                 @default(true)
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  deletedAt       DateTime?               @map("deleted_at")
  concesionaria   Concesionaria           @relation(fields: [concesionariaId], references: [id])
  solicitudes     SolicitudFinanciacion[]

  @@unique([concesionariaId, nombre])
  @@index([concesionariaId])
  @@map("financieras")
}

/// Estado de una publicación en Mercado Libre (espeja el `status` del item).
enum EstadoPublicacionMl {
  borrador
  activa
  pausada
  cerrada
  error
}

/// Estado de una pregunta de Mercado Libre.
enum EstadoPreguntaMl {
  sin_responder
  respondida
  eliminada
}

/// Cómo se atienden las llamadas a la API de una cuenta. Mismo criterio que
/// `EntornoAfip.mock`: `demo` = respuestas simuladas dentro del sistema, sin red
/// y sin credenciales; `real` = la API de Mercado Libre de verdad.
enum ModoCuentaMl {
  real
  demo
}

/// Cuenta de Mercado Libre vinculada por OAuth. Los tokens se guardan CIFRADOS
/// en reposo (secretBox, misma clave que las integraciones): con ellos se puede
/// publicar y responder en nombre del vendedor.
model MercadoLibreCuenta {
  id              Int       @id @default(autoincrement())
  concesionariaId Int       @map("concesionaria_id")
  /// user_id del vendedor en Mercado Libre.
  mlUserId        String    @map("ml_user_id")
  nickname        String?
  siteId          String    @default("MLA") @map("site_id")
  /// Una cuenta 'demo' NUNCA sale a la red: sus llamadas las responde el
  /// simulador. Existe para mostrar el circuito completo sin credenciales.
  modo            ModoCuentaMl @default(real)
  /// Cifrados en reposo (AES-256-GCM): la vinculación se rechaza si falta
  /// INTEGRACIONES_SECRET_KEY, así que acá NUNCA hay texto plano (a diferencia
  /// de las integraciones viejas, que sí admiten filas legadas sin cifrar).
  /// El refresh es de un solo uso: cada renovación devuelve uno nuevo que
  /// reemplaza al anterior.
  accessToken     String    @map("access_token")
  refreshToken    String    @map("refresh_token")
  expiraEn        DateTime  @map("expira_en")
  activa          Boolean   @default(true)
  ultimoError     String?   @map("ultimo_error")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  concesionaria   Concesionaria     @relation(fields: [concesionariaId], references: [id])
  publicaciones   PublicacionMl[]
  preguntas       PreguntaMl[]

  @@unique([concesionariaId, mlUserId])
  @@index([concesionariaId])
  @@map("mercadolibre_cuentas")
}

/// Publicación de un vehículo en Mercado Libre. Un vehículo puede tener a lo
/// sumo una publicación viva por cuenta.
model PublicacionMl {
  id              Int                 @id @default(autoincrement())
  concesionariaId Int                 @map("concesionaria_id")
  cuentaId        Int                 @map("cuenta_id")
  vehiculoId      Int                 @map("vehiculo_id")
  /// Id del item en Mercado Libre (MLA...). Null mientras es borrador local.
  itemId          String?             @map("item_id")
  permalink       String?
  estado          EstadoPublicacionMl @default(borrador)
  /// gold_special (clásica), gold_pro (premium), free...
  listingTypeId   String              @default("gold_special") @map("listing_type_id")
  categoriaId     String?             @map("categoria_id")
  titulo          String
  /// Precio con el que se publicó, para detectar desincronización con el stock.
  precioPublicado Decimal?            @map("precio_publicado") @db.Decimal(14, 2)
  monedaPublicada String?             @map("moneda_publicada")
  ultimoError     String?             @map("ultimo_error")
  ultimaSyncAt    DateTime?           @map("ultima_sync_at")
  /// Cuándo se pausó el aviso A MANO desde el panel. Distingue esa pausa de la
  /// automática (vehículo reservado): la sincronización toma al vehículo como
  /// fuente de verdad y, con el vehículo en 'publicado', reactivaba sola lo que
  /// el usuario acababa de pausar. Con la marca puesta nadie reabre el aviso
  /// salvo un "Reactivar" explícito, que es lo único que la limpia.
  pausadaManualmenteEn DateTime?      @map("pausada_manualmente_en")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  deletedAt       DateTime?           @map("deleted_at")
  concesionaria   Concesionaria       @relation(fields: [concesionariaId], references: [id])
  cuenta          MercadoLibreCuenta  @relation(fields: [cuentaId], references: [id])
  vehiculo        Vehiculo            @relation(fields: [vehiculoId], references: [id])
  preguntas       PreguntaMl[]

  /// El unique lleva concesionariaId: la tabla es tenant-scoped y todas las
  /// consultas van con el tenant inyectado, así que un unique GLOBAL sobre
  /// item_id hacía que una fila invisible de otra concesionaria bloqueara el
  /// insert con un P2002 imposible de diagnosticar desde el tenant dueño.
  @@unique([concesionariaId, itemId])
  @@index([concesionariaId, estado])
  @@index([vehiculoId])
  @@map("publicaciones_ml")
}

/// Pregunta hecha en una publicación de Mercado Libre. Es el equivalente a una
/// consulta entrante: se puede responder desde el sistema y registrar como lead.
model PreguntaMl {
  id              Int                @id @default(autoincrement())
  concesionariaId Int                @map("concesionaria_id")
  cuentaId        Int                @map("cuenta_id")
  publicacionId   Int?               @map("publicacion_id")
  /// Id de la pregunta en Mercado Libre (único por tenant: las notificaciones
  /// se repiten y el upsert reentra por acá sin duplicar).
  mlQuestionId    String             @map("ml_question_id")
  itemId          String             @map("item_id")
  /// user_id de quien pregunta (Mercado Libre NO expone su teléfono).
  mlFromUserId    String?            @map("ml_from_user_id")
  nombreContacto  String?            @map("nombre_contacto")
  texto           String
  respuesta       String?
  estado          EstadoPreguntaMl   @default(sin_responder)
  /// Vendedor que la atiende.
  asignadoAId     Int?               @map("asignado_a_id")
  clienteId       Int?               @map("cliente_id")
  preguntadaEn    DateTime           @map("preguntada_en")
  respondidaEn    DateTime?          @map("respondida_en")
  respondidaPorId Int?               @map("respondida_por_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  deletedAt       DateTime?          @map("deleted_at")
  concesionaria   Concesionaria      @relation(fields: [concesionariaId], references: [id])
  cuenta          MercadoLibreCuenta @relation(fields: [cuentaId], references: [id])
  publicacion     PublicacionMl?     @relation(fields: [publicacionId], references: [id])
  cliente         Cliente?           @relation(fields: [clienteId], references: [id])
  asignadoA       Usuario?           @relation("PreguntaMlAsignada", fields: [asignadoAId], references: [id])
  respondidaPor   Usuario?           @relation("PreguntaMlRespondida", fields: [respondidaPorId], references: [id])

  /// Unique POR TENANT, no global: el upsert de la ingesta va scopeado por
  /// concesionaria, así que con un unique global una pregunta ya ingerida en
  /// otro tenant (misma cuenta de ML re-vinculada, tenant de demo migrado al
  /// real) hacía que el upsert cayera en el create y reventara con un P2002
  /// que se tragaba el catch por-pregunta: la bandeja del tenant legítimo
  /// quedaba vacía para siempre y sin ningún error visible.
  @@unique([concesionariaId, mlQuestionId])
  @@index([concesionariaId, estado, preguntadaEn])
  @@index([publicacionId])
  @@map("preguntas_ml")
}

/// Estado del socket de WhatsApp de una cuenta vinculada.
enum EstadoWhatsappCuenta {
  desconectado
  conectando
  esperando_qr
  conectado
  reconectando
  error
}

/// Quién opera el número. `baileys` se vincula por QR como un WhatsApp Web
/// (el número SIGUE funcionando en el celular); `cloud_api` es la API oficial
/// de Meta (sin socket, sin riesgo de ban, pero captura el número). Hoy sólo
/// está implementado baileys; el enum deja el camino abierto.
enum ProveedorWhatsapp {
  baileys
  cloud_api
}

/// Circuit breaker por salud de entrega del número (anti-ban): normal (verde),
/// ralentizado (envía más lento), pausado (no envía).
enum SaludNumeroWhatsapp {
  normal
  ralentizado
  pausado
}

/// Por dónde entró el hilo. La bandeja es UNA sola para todos los canales (un
/// vendedor atiende consultas, no canales): esto es la etiqueta que dice el
/// origen, no una partición de la pantalla.
///
/// Los dos "_comentario" son públicos: responder ahí lo lee cualquiera que pase
/// por la publicación, a diferencia de un DM. La UI tiene que decirlo.
enum CanalConversacion {
  whatsapp
  instagram
  messenger
  instagram_comentario
  facebook_comentario
}

enum EstadoConversacion {
  abierta
  cerrada
  archivada
}

enum DireccionMensaje {
  entrante
  saliente
}

enum EstadoMensajeWhatsapp {
  pendiente
  enviando
  enviado
  entregado
  leido
  fallido
  recibido
}

/// Tipo de contenido del mensaje. Nació con WhatsApp (de ahí el nombre) pero es
/// el tipo de TODOS los canales de la bandeja: los DM y los comentarios de Meta
/// se mapean sobre estos mismos valores (un comentario entra como `texto`; qué
/// es se sabe por `Conversacion.canal`, que es lo que decide cómo responderlo).
///
/// NO se agregaron valores nuevos a propósito. En Postgres un valor de enum NO
/// se puede borrar (hay que recrear el tipo y reescribir la columna), así que
/// sumar `comentario`/`historia`/`reaccion` "por las dudas" deja una marca
/// permanente en la base a cambio de nada. Sumar uno cuando de verdad haga falta
/// es una migración de una línea; sacarlo, no.
enum TipoMensajeWhatsapp {
  texto
  imagen
  audio
  video
  documento
  ubicacion
  contacto
  sistema
}

/// Número de WhatsApp vinculado a la concesionaria. La sesión de Baileys vive
/// en disco (WHATSAPP_AUTH_DIR/<id>), no acá: este registro es el estado y la
/// configuración del número.
model WhatsappCuenta {
  id                 Int                   @id @default(autoincrement())
  concesionariaId    Int                   @map("concesionaria_id")
  alias              String
  numero             String?
  estado             EstadoWhatsappCuenta  @default(desconectado)
  proveedor          ProveedorWhatsapp     @default(baileys)
  activa             Boolean               @default(true)
  ultimoError        String?               @map("ultimo_error")
  /// Circuit breaker de entrega (ver salud-numero): fuente de verdad del ritmo.
  saludEstado        SaludNumeroWhatsapp   @default(normal) @map("salud_estado")
  saludMotivo        String?               @map("salud_motivo")
  saludDesde         DateTime?             @map("salud_desde")
  /// Anti-ban: instante del próximo envío permitido. Cada envío avanza el slot
  /// un gap aleatorio, calculado atómicamente en SQL (evita ráfagas).
  proximoEnvioAt     DateTime?             @map("proximo_envio_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  deletedAt          DateTime?             @map("deleted_at")
  concesionaria      Concesionaria         @relation(fields: [concesionariaId], references: [id])
  conversaciones     Conversacion[]

  @@unique([concesionariaId, alias])
  @@index([concesionariaId])
  @@map("whatsapp_cuentas")
}

/// Hilo con un contacto, de CUALQUIER canal (WhatsApp, DM de Instagram o
/// Messenger, comentario de Instagram o de la página de Facebook). Se vincula al
/// Cliente por teléfono cuando existe; si no, queda suelta y se puede registrar
/// como consulta desde la bandeja (reusa la ingesta de leads).
///
/// POR QUÉ `claveHilo` Y NO UN UNIQUE COMPUESTO DE COLUMNAS
/// Cada canal identifica al contacto con algo distinto: WhatsApp con el teléfono,
/// los DM con el IGSID/PSID, los comentarios con el par post + comentario raíz.
/// Un `@@unique([concesionariaId, canal, telefono, contactoExternoId, ...])` NO
/// deduplicaría nada: en Postgres dos filas con un NULL en cualquier columna del
/// índice no chocan, así que apenas un canal deje una parte en null volverían a
/// entrar hilos duplicados por cada mensaje. `claveHilo` es UNA columna NOT NULL
/// que siempre tiene valor. La deriva `claveHiloDe()` en
/// src/application/services/conversacionService.ts — ÚNICA fuente de verdad del
/// formato, y el backfill de la migración 20260825120000 lo reproduce en SQL.
///
/// Para WhatsApp vale `<whatsappCuentaId>:<telefono>`. Incluir la cuenta en la
/// clave preserva EXACTAMENTE la semántica del unique viejo
/// [whatsappCuentaId, telefono]: dos números de la misma concesionaria siguen
/// teniendo hilos separados con el mismo contacto. Y como una cuenta pertenece a
/// una sola concesionaria, agregar concesionariaId al unique no lo afloja ni lo
/// aprieta — es la misma restricción escrita de una forma que también sirve para
/// Meta. Ésta fue la forma que menos código rompe: sólo cambia la clave de
/// búsqueda del hilo en obtenerOCrearConversacion, ningún flujo más.
model Conversacion {
  id                  Int                @id @default(autoincrement())
  concesionariaId     Int                @map("concesionaria_id")
  canal               CanalConversacion  @default(whatsapp)
  /// Clave natural del hilo dentro del canal. NOT NULL a propósito (ver arriba).
  claveHilo           String             @map("clave_hilo")
  /// Sólo WhatsApp. Nullable porque los canales de Meta no tienen cuenta de WhatsApp.
  whatsappCuentaId    Int?               @map("whatsapp_cuenta_id")
  /// Sólo Meta: la IntegracionCanal (página de Facebook / cuenta de Instagram)
  /// por la que entró el hilo. Es también quien tiene el token para responder.
  integracionId       Int?               @map("integracion_id")
  clienteId           Int?               @map("cliente_id")
  /// Nullable: un DM de Instagram no trae teléfono. Sigue siendo el identificador
  /// de WhatsApp y el que usa el dedupe contra Cliente.
  telefono            String?
  jid                 String?
  /// Id del usuario del otro lado en Meta (IGSID o PSID). Es un id SCOPED a la
  /// app/página: el mismo humano tiene ids distintos en dos páginas, por eso la
  /// integración también entra en `claveHilo`.
  contactoExternoId   String?            @map("contacto_externo_id")
  /// Sólo comentarios: id del post y del comentario RAÍZ del hilo, que es a lo
  /// que hay que contestarle para que la respuesta caiga en el hilo correcto.
  postExternoId       String?            @map("post_externo_id")
  comentarioExternoId String?            @map("comentario_externo_id")
  nombreContacto      String?            @map("nombre_contacto")
  estado              EstadoConversacion @default(abierta)
  /// Vendedor que atiende el hilo (null = sin asignar).
  asignadoAId         Int?               @map("asignado_a_id")
  /// Cierre de la ventana de 24 h de Meta: pasado ese instante la Send API
  /// rechaza el envío. Se corre 24 h hacia adelante con cada mensaje del usuario.
  /// Null = no aplica (WhatsApp, comentarios) o todavía no se sabe.
  ventanaVenceAt      DateTime?          @map("ventana_vence_at")
  ultimoMensajeAt     DateTime           @default(now()) @map("ultimo_mensaje_at")
  /// Dirección del último mensaje. Denormalizado para filtrar "sin responder"
  /// en la bandeja sin subconsulta por conversación.
  ultimoMensajeDir    DireccionMensaje   @default(entrante) @map("ultimo_mensaje_dir")
  noLeidos            Int                @default(0) @map("no_leidos")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  deletedAt           DateTime?          @map("deleted_at")
  concesionaria       Concesionaria      @relation(fields: [concesionariaId], references: [id])
  /// onDelete EXPLÍCITO: para una relación opcional el default de Prisma es
  /// SetNull, y acá eso significa que borrar una fila de whatsapp_cuentas dejaría
  /// los hilos vivos de ese número huérfanos EN SILENCIO (sin cuenta, con la
  /// clave apuntando a una cuenta que ya no existe: el vendedor no puede
  /// responder y revincular el número por QR abre hilos nuevos, partiendo la
  /// bandeja en dos). Antes de multi-canal la columna era NOT NULL y Postgres lo
  /// frenaba con RESTRICT; nullable y RESTRICT no se pelean, así que se conserva
  /// esa guarda: la columna puede nacer NULL (los hilos de Meta) y aun así no se
  /// puede borrar una cuenta que tiene hilos apuntándole.
  whatsappCuenta      WhatsappCuenta?    @relation(fields: [whatsappCuentaId], references: [id], onDelete: Restrict)
  /// Acá SÍ corresponde SetNull: si se elimina la integración de Meta, el
  /// historial del hilo se conserva y sólo deja de tener por dónde responder.
  integracion         IntegracionCanal?  @relation(fields: [integracionId], references: [id])
  cliente             Cliente?           @relation(fields: [clienteId], references: [id])
  asignadoA           Usuario?           @relation("ConversacionAsignada", fields: [asignadoAId], references: [id])
  mensajes            MensajeWhatsapp[]

  @@unique([concesionariaId, canal, claveHilo])
  @@index([concesionariaId, estado, ultimoMensajeAt])
  /// Filtro por canal de la bandeja (chips "WhatsApp / Instagram / ...").
  @@index([concesionariaId, canal, ultimoMensajeAt])
  @@index([concesionariaId, ultimoMensajeDir, noLeidos])
  @@index([clienteId])
  @@index([integracionId])
  @@map("conversaciones")
}

model MensajeWhatsapp {
  id             Int                   @id @default(autoincrement())
  concesionariaId Int                  @map("concesionaria_id")
  conversacionId Int                   @map("conversacion_id")
  direccion      DireccionMensaje
  tipo           TipoMensajeWhatsapp   @default(texto)
  contenido      String
  estado         EstadoMensajeWhatsapp @default(pendiente)
  /// Id que asigna WhatsApp. Único POR conversación (se repite entre chats).
  waMessageId    String?               @map("wa_message_id")
  /// Id del mensaje o del comentario en Meta (`mid` de la Send API, `comment_id`
  /// de un comentario). Es la clave de IDEMPOTENCIA de la ingesta: Meta REINTENTA
  /// las notificaciones del webhook y sin esto cada reintento duplicaría la
  /// burbuja. Null en WhatsApp (ahí el id es `waMessageId`).
  externoId      String?               @map("externo_id")
  mediaUrl       String?               @map("media_url")
  mediaMimeType  String?               @map("media_mime_type")
  /// Usuario que lo envió desde el panel (null = entrante o automático).
  enviadoPorId   Int?                  @map("enviado_por_id")
  errorMensaje   String?               @map("error_mensaje")
  /// Instante en que el worker puede despacharlo (espaciado anti-ban).
  enviarAt       DateTime?             @map("enviar_at")
  intentos       Int                   @default(0)
  createdAt      DateTime              @default(now()) @map("created_at")
  enviadoEn      DateTime?             @map("enviado_en")
  entregadoEn    DateTime?             @map("entregado_en")
  leidoEn        DateTime?             @map("leido_en")
  deletedAt      DateTime?             @map("deleted_at")
  conversacion   Conversacion          @relation(fields: [conversacionId], references: [id])
  enviadoPor     Usuario?              @relation("MensajeEnviadoPor", fields: [enviadoPorId], references: [id])

  @@unique([conversacionId, waMessageId])
  /// Idempotencia de la ingesta de Meta: el reintento del webhook choca acá y se
  /// traga en silencio (mismo patrón que el unique de waMessageId con Baileys).
  @@unique([conversacionId, externoId])
  @@index([conversacionId, createdAt])
  @@index([estado, enviarAt])
  @@map("mensajes_whatsapp")
}

/// Cómo se atienden las llamadas de una integración de canales. Mismo criterio
/// que `ModoCuentaMl` y que `EntornoAfip.mock`: `demo` = todo se resuelve
/// ADENTRO del sistema, sin red y sin credenciales; `real` = las APIs de verdad.
enum ModoIntegracion {
  real
  demo
}

/// Config de ingesta automática de consultas por tenant: webhook de Meta
/// (Lead Ads) o casilla IMAP (avisos de DeRuedas). `config` guarda las
/// credenciales del canal, cifradas en reposo (AES-256-GCM) cuando
/// INTEGRACIONES_SECRET_KEY está seteada; sin la clave quedan en claro y las
/// protege sólo la RLS (ver infrastructure/security/secretBox.ts).
model IntegracionCanal {
  id              Int                  @id @default(autoincrement())
  concesionariaId Int                  @map("concesionaria_id")
  tipo            TipoIntegracionCanal
  nombre          String
  activo          Boolean              @default(true)
  /// Una integración 'demo' NUNCA sale a la red: el envío lo resuelve el desvío
  /// de `metaEnvio.despacharMensajeMeta` adentro del sistema, y sus canales se
  /// reportan HABILITADOS aunque el config no tenga tokens, porque no hay
  /// ninguno que cargar. Existe para poder mostrar la bandeja de Instagram,
  /// Messenger y comentarios mientras Meta no aprueba el App Review; todo lo
  /// que genera va rotulado como simulación en la pantalla.
  modo            ModoIntegracion      @default(real)
  config          Json
  /// Última consulta ingerida OK y último error del canal (diagnóstico en Ajustes).
  ultimoEvento    DateTime?            @map("ultimo_evento")
  ultimoError     String?              @map("ultimo_error")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  deletedAt       DateTime?            @map("deleted_at")
  concesionaria   Concesionaria        @relation(fields: [concesionariaId], references: [id])
  /// Hilos de la bandeja que entraron por esta integración (canales de Meta).
  conversaciones  Conversacion[]

  @@index([concesionariaId])
  @@map("integraciones_canal")
}

model SolicitudFinanciacion {
  id              Int                            @id @default(autoincrement())
  concesionariaId Int                            @map("concesionaria_id")
  sucursalId      Int?                           @map("sucursal_id")
  ventaId         Int?                           @map("venta_id")
  presupuestoId   Int?                           @map("presupuesto_id")
  // Qué unidad se financia. Opcional: existe la pre-aprobación crediticia, donde
  // el cliente pregunta cuánto le prestan antes de elegir auto. Sin @unique a
  // propósito: un mismo vehículo puede tener varias solicitudes (a distintos
  // bancos, o una nueva tras un rechazo). No se deriva de presupuestoId porque
  // un presupuesto puede tener varios items, ni de ventaId porque la venta
  // recién existe después de la aprobación.
  vehiculoId      Int?                           @map("vehiculo_id")
  clienteId       Int                            @map("cliente_id")
  financieraId    Int                            @map("financiera_id")
  estado          EstadoSolicitudFinanciacion    @default(borrador)
  montoSolicitado Decimal?                       @map("monto_solicitado") @db.Decimal(12, 2)
  plazoCuotas     Int?                           @map("plazo_cuotas")
  tasaEstimada    Decimal?                       @map("tasa_estimada") @db.Decimal(8, 4)
  fechaEnvio      DateTime?                      @map("fecha_envio")
  fechaRespuesta  DateTime?                      @map("fecha_respuesta")
  montoAprobado   Decimal?                       @map("monto_aprobado") @db.Decimal(12, 2)
  tasaFinal       Decimal?                       @map("tasa_final") @db.Decimal(8, 4)
  observaciones   String?
  createdAt       DateTime                       @default(now()) @map("created_at")
  updatedAt       DateTime                       @updatedAt @map("updated_at")
  deletedAt       DateTime?                      @map("deleted_at")
  archivos        SolicitudFinanciacionArchivo[]
  cliente         Cliente                        @relation(fields: [clienteId], references: [id])
  concesionaria   Concesionaria                  @relation(fields: [concesionariaId], references: [id])
  financiera      Financiera                     @relation(fields: [financieraId], references: [id])
  presupuesto     Presupuesto?                   @relation(fields: [presupuestoId], references: [id])
  sucursal        Sucursal?                      @relation(fields: [sucursalId], references: [id])
  venta           Venta?                         @relation(fields: [ventaId], references: [id])
  vehiculo        Vehiculo?                      @relation(fields: [vehiculoId], references: [id])

  @@index([concesionariaId])
  @@index([sucursalId])
  @@index([clienteId])
  @@index([financieraId])
  @@index([vehiculoId])
  @@index([estado])
  @@map("solicitudes_financiacion")
}

model SolicitudFinanciacionArchivo {
  id              Int                   @id @default(autoincrement())
  concesionariaId Int?                   @map("concesionaria_id")
  solicitudId     Int                   @map("solicitud_id")
  tipo            String?
  url             String
  descripcion     String?
  originalName    String?               @map("original_name")
  mimeType        String?               @map("mime_type")
  sizeBytes       Int?                  @map("size_bytes")
  storageKey      String?               @map("storage_key")
  uploadedById    Int?                  @map("uploaded_by_id")
  createdAt       DateTime              @default(now()) @map("created_at")
  deletedAt       DateTime?             @map("deleted_at")
  solicitud       SolicitudFinanciacion @relation(fields: [solicitudId], references: [id])

  @@index([concesionariaId])
  @@index([solicitudId])
  @@map("solicitud_financiacion_archivos")
}

model PostventaCaso {
  id              Int             @id @default(autoincrement())
  concesionariaId Int             @map("concesionaria_id")
  sucursalId      Int             @map("sucursal_id")
  ventaId         Int             @map("venta_id")
  vehiculoId      Int             @map("vehiculo_id")
  clienteId       Int             @map("cliente_id")
  fechaReclamo    DateTime        @map("fecha_reclamo") @db.Date
  // Tipo del reclamo, tomado del catálogo TipoPostventa.
  tipoId          Int?            @map("tipo_id")
  // Tipo en texto libre: sólo para los casos históricos, cargados antes de que
  // existiera el catálogo. No se escribe más desde la app; se mantiene para no
  // perder el dato (y porque borrar la columna haría abortar el `db push` del
  // arranque). Al leer, gana `tipoRef.nombre` y esto es el fallback.
  tipo            String?
  descripcion     String
  estado          EstadoPostventa @default(pendiente)
  /// Monto facturado al cliente por el trabajo (revenue). El margen = facturado −
  /// costo de los items (gasto a proveedores). Null hasta que se factura.
  montoFacturado  Decimal?        @map("monto_facturado") @db.Decimal(12, 2)
  fechaCierre     DateTime?       @map("fecha_cierre") @db.Date
  // Turno de taller: cuándo se espera la unidad. Opcional (el turno se coordina
  // después de abrir el caso). La hora va aparte como texto "HH:MM" para no
  // pelear con zonas horarias (fecha_turno es @db.Date, medianoche UTC).
  fechaTurno      DateTime?       @map("fecha_turno") @db.Date
  horaTurno       String?         @map("hora_turno")
  /// Recordatorio de próximo service/mantenimiento (retención): cuándo debería
  /// volver el cliente. Se suele cargar al cerrar el caso. Opcional.
  proximoServiceFecha DateTime?   @map("proximo_service_fecha") @db.Date
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")
  cliente         Cliente         @relation(fields: [clienteId], references: [id])
  concesionaria   Concesionaria   @relation(fields: [concesionariaId], references: [id])
  sucursal        Sucursal        @relation(fields: [sucursalId], references: [id])
  vehiculo        Vehiculo        @relation("CasoVehiculo", fields: [vehiculoId], references: [id])
  venta           Venta           @relation(fields: [ventaId], references: [id])
  tipoRef         TipoPostventa?  @relation(fields: [tipoId], references: [id])
  items           PostventaItem[]

  @@index([concesionariaId])
  @@index([sucursalId])
  @@index([ventaId])
  @@index([vehiculoId])
  @@index([clienteId])
  @@index([tipoId])
  @@index([estado])
  @@index([concesionariaId, fechaTurno])
  @@index([concesionariaId, proximoServiceFecha])
  @@map("postventa_casos")
}

/// Catálogo de tipos de reclamo de postventa (mecánica, climatización,
/// tapicería...). Existe para estandarizar: antes el tipo era texto libre y el
/// desplegable se armaba con lo que hubiera cargado, así que cualquier variante
/// ortográfica ("mecanica" / "Mecánica") aparecía como un tipo distinto.
/// Renombrar acá arrastra a todos los casos, porque apuntan por id.
model TipoPostventa {
  id              Int             @id @default(autoincrement())
  concesionariaId Int             @map("concesionaria_id")
  nombre          String
  /// Archivar un tipo sin borrarlo: deja de ofrecerse en el alta, pero los casos
  /// históricos que lo usan lo siguen mostrando.
  activo          Boolean         @default(true)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")
  concesionaria   Concesionaria   @relation(fields: [concesionariaId], references: [id])
  casos           PostventaCaso[]

  @@unique([concesionariaId, nombre])
  @@index([concesionariaId])

// ---------------------------------------------------------------------------
// Catálogo InfoAuto (fuente: API pública de argautos.com).
// Datos de referencia globales, compartidos por todas las concesionarias: NO
// llevan concesionaria_id. Los ids son los de la API (no autoincrement) para
// poder upsertear en cada sync. Los campos *_synced_at marcan hasta dónde
// avanzó el sync incremental (la cuota anónima es de ~30 requests/día).
// ---------------------------------------------------------------------------

model InfoautoBrand {
  id             Int             @id
  name           String
  modelsCount    Int             @default(0) @map("models_count")
  modelsSyncedAt DateTime?       @map("models_synced_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")
  models         InfoautoModel[]

  @@index([name])
  @@map("infoauto_brands")
}

model InfoautoModel {
  id               Int               @id
  brandId          Int               @map("brand_id")
  name             String
  versionsCount    Int               @default(0) @map("versions_count")
  versionsSyncedAt DateTime?         @map("versions_synced_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")
  brand            InfoautoBrand     @relation(fields: [brandId], references: [id])
  versions         InfoautoVersion[]

  @@index([brandId])
  @@index([name])
  @@map("infoauto_models")
}

model InfoautoVersion {
  id             Int             @id
  modelId        Int             @map("model_id")
  name           String
  availableYears Int[]           @map("available_years")
  pricesSyncedAt DateTime?       @map("prices_synced_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")
  model          InfoautoModel   @relation(fields: [modelId], references: [id])
  prices         InfoautoPrice[]

  @@index([modelId])
  @@map("infoauto_versions")
}

model InfoautoPrice {
  id           Int             @id @default(autoincrement())
  versionId    Int             @map("version_id")
  // year 0 = 0km (año-modelo más reciente, precio de unidad nueva)
  year         Int
  priceUsd     Decimal?        @map("price_usd") @db.Decimal(12, 2)
  exchangeRate Decimal?        @map("exchange_rate") @db.Decimal(12, 2)
  recordedAt   DateTime?       @map("recorded_at") @db.Date
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  deletedAt    DateTime?       @map("deleted_at")
  version      InfoautoVersion @relation(fields: [versionId], references: [id])

  @@unique([versionId, year])
  @@map("infoauto_prices")
}

// Tokens de un solo uso para recuperación de contraseña. Se guarda solo el hash
// del token; el token en claro viaja únicamente en el link enviado por email.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  usuarioId Int       @map("usuario_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([tokenHash])
  @@index([usuarioId])
  @@map("password_reset_tokens")
}

// ── Facturación electrónica AFIP ──────────────────────────────────────────────

/// Condición frente al IVA (emisor y receptor). Determina el tipo de comprobante
/// (RI→A/B, Monotributo→C) y si el IVA se discrimina.
enum CondicionIva {
  responsable_inscripto
  monotributo
  exento
  consumidor_final
}

/// Tipo de documento del receptor. Mapea a los códigos de AFIP en el use-case
/// (CUIT→80, CUIL→86, DNI→96, CF→99).
enum TipoDocumento {
  CUIT
  CUIL
  DNI
  CF
}

/// Tipo/letra de comprobante. Mapea a los códigos de AFIP (A→1, B→6, C→11).
enum TipoComprobanteAfip {
  factura_a
  factura_b
  factura_c
}

enum EstadoComprobanteAfip {
  pendiente
  emitida
  error
}

/// Entorno de emisión. `mock` = CAE simulado (sin AFIP); `homologacion`/`produccion`
/// = WSAA+WSFEv1 real (requiere certificado, Corte 2).
enum EntornoAfip {
  mock
  homologacion
  produccion
}

/// Comprobante electrónico (factura) emitido para una Venta. Snapshot fiscal: se
/// guardan los datos del receptor y los importes AL MOMENTO de emitir (no se
/// dependen del Cliente/Venta actuales). Una factura por venta (ventaId único).
model ComprobanteAfip {
  id               Int                   @id @default(autoincrement())
  concesionariaId  Int                   @map("concesionaria_id")
  ventaId          Int                   @unique @map("venta_id")
  // Cabecera
  tipoComprobante  TipoComprobanteAfip   @map("tipo_comprobante")
  puntoVenta       Int                   @map("punto_venta")
  numero           Int
  concepto         Int                   @default(1) // 1 = productos
  fechaComprobante DateTime              @map("fecha_comprobante") @db.Date
  // Receptor (snapshot)
  receptorNombre   String                @map("receptor_nombre")
  receptorDocTipo  Int                   @map("receptor_doc_tipo") // código AFIP (80/86/96/99)
  receptorDocNro   String                @map("receptor_doc_nro")
  receptorCondIva  CondicionIva          @map("receptor_cond_iva")
  // Importes (moneda del comprobante: PES/DOL)
  moneda           String                @default("PES")
  cotizacion       Decimal               @default(1) @db.Decimal(18, 6)
  neto             Decimal               @db.Decimal(14, 2)
  alicuotaIva      Decimal               @map("alicuota_iva") @db.Decimal(5, 2)
  iva              Decimal               @db.Decimal(14, 2)
  total            Decimal               @db.Decimal(14, 2)
  // Resultado AFIP
  estado           EstadoComprobanteAfip @default(pendiente)
  entorno          EntornoAfip
  cae              String?
  caeVencimiento   DateTime?             @map("cae_vencimiento") @db.Date
  qrData           String?               @map("qr_data") // string base64 del QR (RG 4291)
  errorMsg         String?               @map("error_msg")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  deletedAt        DateTime?             @map("deleted_at")
  concesionaria    Concesionaria         @relation(fields: [concesionariaId], references: [id])
  venta            Venta                 @relation(fields: [ventaId], references: [id])

  @@unique([concesionariaId, tipoComprobante, puntoVenta, numero], map: "comprobantes_afip_numero_key")
  @@index([concesionariaId])
  @@index([concesionariaId, tipoComprobante, puntoVenta])
  @@map("comprobantes_afip")
}

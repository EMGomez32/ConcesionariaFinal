model Plan {
  id            Int                         @id @default(autoincrement())
  nombre        String                      @unique
  interval      PlanInterval                @default(MONTH)
  precio        Decimal                     @db.Decimal(12, 2)
  moneda        String                      @default("ARS")
  maxUsuarios   Int?                        @map("max_usuarios")
  maxSucursales Int?                        @map("max_sucursales")
  maxVehiculos  Int?                        @map("max_vehiculos")
  activo        Boolean                     @default(true)
  createdAt     DateTime                    @default(now()) @map("created_at")
  updatedAt     DateTime                    @updatedAt @map("updated_at")
  deletedAt     DateTime?                   @map("deleted_at")
  subscriptions ConcesionariaSubscription[]

  @@map("planes")
}

model ConcesionariaSubscription {
  id                     Int                @id @default(autoincrement())
  concesionariaId        Int                @unique @map("concesionaria_id")
  planId                 Int                @map("plan_id")
  status                 SubscriptionStatus @default(trialing)
  trialEndsAt            DateTime?          @map("trial_ends_at")
  currentPeriodStart     DateTime?          @map("current_period_start")
  currentPeriodEnd       DateTime?          @map("current_period_end")
  provider               String?            @map("provider")
  providerCustomerId     String?            @map("provider_customer_id")
  providerSubscriptionId String?            @map("provider_subscription_id")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  deletedAt              DateTime?          @map("deleted_at")
  concesionaria          Concesionaria      @relation(fields: [concesionariaId], references: [id])
  plan                   Plan               @relation(fields: [planId], references: [id])
  invoices               Invoice[]

  @@index([planId])
  @@index([status])
  @@map("concesionaria_subscriptions")
}

model Invoice {
  id                Int                       @id @default(autoincrement())
  concesionariaId   Int?                       @map("concesionaria_id")
  subscriptionId    Int                       @map("subscription_id")
  status            InvoiceStatus             @default(open)
  numero            String?
  periodoDesde      DateTime?                 @map("periodo_desde")
  periodoHasta      DateTime?                 @map("periodo_hasta")
  subtotal          Decimal                   @db.Decimal(12, 2)
  impuestos         Decimal                   @default(0) @db.Decimal(12, 2)
  total             Decimal                   @db.Decimal(12, 2)
  moneda            String                    @default("ARS")
  dueDate           DateTime?                 @map("due_date")
  paidAt            DateTime?                 @map("paid_at")
  providerInvoiceId String?                   @map("provider_invoice_id")
  pdfUrl            String?                   @map("pdf_url")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")
  deletedAt         DateTime?                 @map("deleted_at")
  subscription      ConcesionariaSubscription @relation(fields: [subscriptionId], references: [id])
  payments          Payment[]

  @@index([concesionariaId])
  @@index([subscriptionId])
  @@index([status])
  @@map("invoices")
}

model Payment {
  id                Int           @id @default(autoincrement())
  concesionariaId   Int?           @map("concesionaria_id")
  invoiceId         Int           @map("invoice_id")
  status            PaymentStatus @default(pending)
  monto             Decimal       @db.Decimal(12, 2)
  moneda            String        @default("ARS")
  provider          String?
  providerPaymentId String?       @map("provider_payment_id")
  metodo            MetodoPago?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")
  invoice           Invoice       @relation(fields: [invoiceId], references: [id])

  @@index([concesionariaId])
  @@index([invoiceId])
  @@index([status])
  @@map("payments")
}


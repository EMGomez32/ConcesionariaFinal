model Venta {
  id                      Int                     @id @default(autoincrement())
  concesionariaId         Int                     @map("concesionaria_id")
  sucursalId              Int                     @map("sucursal_id")
  vehiculoId              Int                     @unique @map("vehiculo_id")
  presupuestoId           Int?                    @unique @map("presupuesto_id")
  clienteId               Int                     @map("cliente_id")
  vendedorId              Int                     @map("vendedor_id")
  fechaVenta              DateTime                @map("fecha_venta") @db.Date
  precioVenta             Decimal                 @map("precio_venta") @db.Decimal(12, 2)
  moneda                  String                  @default("ARS")
  formaPago               FormaPagoVenta          @default(contado) @map("forma_pago")
  observaciones           String?
  estadoEntrega           EstadoEntrega           @default(pendiente) @map("estado_entrega")
  fechaEntrega            DateTime?               @map("fecha_entrega") @db.Date
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")
  deletedAt               DateTime?               @map("deleted_at")
  // Una venta puede acumular varias financiaciones a lo largo del tiempo: la
  // original y las sucesivas refinanciaciones de su saldo.
  financiaciones          Financiacion[]
  ingresosVehiculo        IngresoVehiculo[]
  postventaCasos          PostventaCaso[]
  reservas                Reserva[]
  solicitudesFinanciacion SolicitudFinanciacion[]
  canjes                  VentaCanjeVehiculo[]
  extras                  VentaExtra[]
  pagos                   VentaPago[]
  comprobanteAfip         ComprobanteAfip?
  cliente                 Cliente                 @relation(fields: [clienteId], references: [id])
  concesionaria           Concesionaria           @relation(fields: [concesionariaId], references: [id])
  presupuesto             Presupuesto?            @relation(fields: [presupuestoId], references: [id])
  sucursal                Sucursal                @relation(fields: [sucursalId], references: [id])
  vehiculo                Vehiculo                @relation(fields: [vehiculoId], references: [id])
  vendedor                Usuario                 @relation("VentaVendedor", fields: [vendedorId], references: [id])

  @@index([concesionariaId])
  @@index([sucursalId])
  @@index([clienteId])
  @@index([vendedorId])
  @@index([fechaVenta])
  @@index([estadoEntrega])
  @@map("ventas")
}


  deletedAt       DateTime?          @map("deleted_at")
  categoria       CategoriaGastoFijo @relation(fields: [categoriaId], references: [id])
  concesionaria   Concesionaria      @relation(fields: [concesionariaId], references: [id])
  proveedor       Proveedor?         @relation(fields: [proveedorId], references: [id])
  sucursal        Sucursal?          @relation(fields: [sucursalId], references: [id])

  @@index([concesionariaId])
  @@index([sucursalId])
  @@index([concesionariaId, anio, mes])
  @@index([categoriaId])
  @@map("gastos_fijos")
}

// Cotización del dólar por día y por tenant. La usan los reportes para
// consolidar totales que hoy se muestran separados por moneda (ARS/USD). Es
// dato de referencia: NO es soft-delete (no tiene deleted_at; se borra físico o
// se pisa por fecha). `valor` = pesos por 1 USD. La extensión RLS inyecta el
// tenant en create/where para el admin; el super_admin lo elige por body.
model Cotizacion {
  id              Int           @id @default(autoincrement())
  concesionariaId Int           @map("concesionaria_id")
  // @db.Date: la cotización es de un día, no de un instante. Igual criterio que
  // gastoVehiculo.fecha para que las comparaciones de rango sean en UTC puro.
  fecha           DateTime      @db.Date
  // pesos por 1 USD. 4 decimales para no perder precisión en cotizaciones altas.
  valor           Decimal       @db.Decimal(14, 4)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  concesionaria   Concesionaria @relation(fields: [concesionariaId], references: [id])

  // Una sola cotización por día y por tenant: la carga es un upsert por fecha.
  @@unique([concesionariaId, fecha])
  @@index([concesionariaId, fecha])
  @@map("cotizaciones")
}

// Objetivo de ventas mensual por tenant. El dueño fija cuántas unidades y/o
// cuánto facturado se propone para un mes; el Dashboard muestra el progreso.
// Dato de configuración: NO es soft-delete (se pisa por período). Mismo patrón
// tenant-scoped que Cotizacion.
model MetaVenta {
  id               Int           @id @default(autoincrement())
  concesionariaId  Int           @map("concesionaria_id")
  anio             Int
  mes              Int
  // Al menos uno de los dos objetivos; el otro puede quedar nulo.
  unidadesObjetivo Int?          @map("unidades_objetivo")
  montoObjetivo    Decimal?      @map("monto_objetivo") @db.Decimal(14, 2)
  moneda           String        @default("ARS")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  concesionaria    Concesionaria @relation(fields: [concesionariaId], references: [id])

  // Una sola meta por mes y por tenant: la carga es un upsert por período.
  @@unique([concesionariaId, anio, mes])
  @@index([concesionariaId, anio, mes])
  @@map("metas_venta")
}

// Objetivo de ventas mensual POR VENDEDOR. El admin le fija a cada vendedor
// cuántas unidades y/o cuánto facturado se propone para un mes; el reporte de
// objetivos muestra el progreso vs sus ventas reales. Complementa MetaVenta (que
// es a nivel tenant) y el ranking/comisiones. Config: NO soft-delete (se pisa por
// período). Mismo patrón tenant-scoped que MetaVenta, más el vendedor.
model ObjetivoVendedor {
  id               Int           @id @default(autoincrement())
  concesionariaId  Int           @map("concesionaria_id")
  vendedorId       Int           @map("vendedor_id")
  anio             Int
  mes              Int
  // Al menos uno de los dos objetivos; el otro puede quedar nulo.
  unidadesObjetivo Int?          @map("unidades_objetivo")
  montoObjetivo    Decimal?      @map("monto_objetivo") @db.Decimal(14, 2)
  moneda           String        @default("ARS")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  concesionaria    Concesionaria @relation(fields: [concesionariaId], references: [id])
  vendedor         Usuario       @relation(fields: [vendedorId], references: [id])

  // Un objetivo por vendedor, mes y tenant: la carga es un upsert por período.
  @@unique([concesionariaId, vendedorId, anio, mes])
  @@index([concesionariaId, anio, mes])
  @@map("objetivos_vendedor")
}

model Presupuesto {

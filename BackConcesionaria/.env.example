# Server
NODE_ENV=development
PORT=3000

# Database (Prisma)
DATABASE_URL="prisma+postgres://localhost:51213/?api_key=..."

# JWT
JWT_SECRET=provide_a_secure_secret_here
JWT_REFRESH_SECRET=provide_another_secure_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Logging
LOG_LEVEL=debug

# Cifrado en reposo de los secretos de integraciones (Meta / casillas IMAP) y de
# los tokens de OAuth de MERCADO LIBRE.
# 64 hex = 32 bytes: openssl rand -hex 32. Sin esta clave, los secretos de las
# integraciones viejas quedan en claro en la base (warning al arranque) y la
# vinculación con Mercado Libre directamente se rechaza: sus tokens permiten
# publicar, CERRAR avisos (irreversible) y contestar en nombre del vendedor, así
# que no se guardan nunca sin cifrar.
INTEGRACIONES_SECRET_KEY=

# --- WhatsApp (Baileys) ---
# Las tres son OPCIONALES: sin ellas el backend arranca con estos mismos
# defaults. En Docker las setea docker-compose.yml (ver el .env de la RAÍZ del
# repo); esto es para correr el backend a mano.
#
# Carpeta donde Baileys guarda las credenciales de cada número vinculado (una
# subcarpeta por cuenta). Si se borra, hay que volver a escanear el QR.
# En Docker apunta a /app/wa-auth, montado sobre el volumen wa-auth.
WHATSAPP_AUTH_DIR=./wa-auth
# Espaciado anti-ban entre envíos consecutivos del MISMO número: cada mensaje
# se agenda a un gap aleatorio entre min y max después del anterior. Baileys no
# es la API oficial de Meta — mandar en ráfaga es la forma más rápida de que
# banéen el número.
WHATSAPP_DELAY_MIN_MS=5000
WHATSAPP_DELAY_MAX_MS=15000

# --- Mercado Libre ---
# Credenciales de la app creada en developers.mercadolibre.com.ar. OPCIONALES y
# solidarias: van las dos o ninguna. Sin ellas el backend arranca igual y la
# integración queda apagada (el worker de sincronización no corre y la pantalla
# de Configuración muestra la cuenta como "no configurada").
# En Docker las setea docker-compose.yml desde el .env de la RAÍZ del repo:
# ponerlas SÓLO acá no llega al contenedor.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Redirect URI del OAuth. Tiene que coincidir EXACTO (protocolo, host, path, sin
# barra de más) con la cargada en la app de Mercado Libre, o el canje del code
# falla con invalid_grant. Vacía = se arma sola como
# <APP_URL>/api/webhooks/mercadolibre/callback.
ML_REDIRECT_URI=
# Sitio de Mercado Libre: MLA = Argentina, MLU = Uruguay, MLC = Chile.
ML_SITE_ID=MLA
# Cada cuánto barre el worker de sincronización: levanta las preguntas cuya
# notificación de webhook se haya perdido y reconcilia precio/estado de las
# publicaciones. Mínimo 30000. La cuota de la API de ML es por aplicación (no
# por vendedor), así que bajarlo la quema para todos los tenants a la vez.
ML_SYNC_INTERVAL_MS=300000

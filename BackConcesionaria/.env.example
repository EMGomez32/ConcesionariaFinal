# Server
NODE_ENV=development
PORT=3000

# Database (Prisma)
DATABASE_URL="prisma+postgres://localhost:51213/?api_key=..."

# JWT
JWT_SECRET=provide_a_secure_secret_here
JWT_REFRESH_SECRET=provide_another_secure_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Logging
LOG_LEVEL=debug

# Cifrado en reposo de los secretos de integraciones (Meta / casillas IMAP).
# 64 hex = 32 bytes: openssl rand -hex 32. Sin esta clave, los secretos quedan
# en claro en la base (warning al arranque).
INTEGRACIONES_SECRET_KEY=

# --- WhatsApp (Baileys) ---
# Las tres son OPCIONALES: sin ellas el backend arranca con estos mismos
# defaults. En Docker las setea docker-compose.yml (ver el .env de la RAÍZ del
# repo); esto es para correr el backend a mano.
#
# Carpeta donde Baileys guarda las credenciales de cada número vinculado (una
# subcarpeta por cuenta). Si se borra, hay que volver a escanear el QR.
# En Docker apunta a /app/wa-auth, montado sobre el volumen wa-auth.
WHATSAPP_AUTH_DIR=./wa-auth
# Espaciado anti-ban entre envíos consecutivos del MISMO número: cada mensaje
# se agenda a un gap aleatorio entre min y max después del anterior. Baileys no
# es la API oficial de Meta — mandar en ráfaga es la forma más rápida de que
# banéen el número.
WHATSAPP_DELAY_MIN_MS=5000
WHATSAPP_DELAY_MAX_MS=15000

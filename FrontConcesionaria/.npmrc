# react-helmet-async@2.0.5 (última publicada) no declara React 19 en sus
# peerDependencies, así que npm aborta con ERESOLVE en cualquier install.
# El paquete funciona bien con React 19; esto sólo evita tener que recordar
# el flag en cada `npm i` (y que CI y local resuelvan distinto).
legacy-peer-deps=true
